{
  "manifest_version": 3,
  "name": "StoryTeller - Web Novel Reader",
  "description": "Extract and listen to web novel chapters, with next-chapter navigation in the reader.",
  "version": "0.1.0",
  "minimum_chrome_version": "109",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": { "default_title": "Read with StoryTeller", "default_popup": "popup.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}